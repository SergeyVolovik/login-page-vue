{
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "auto",
  "proseWrap": "always",
  "trailingComma": "none",
  "plugins": ["prettier-plugin-organize-imports"],
  "ignore": ["node_modules", "dist"],
  "overrides": [
    {
      "files": "*.vue",
      "options": {
        "singleAttributePerLine": true
      }
    }
  ]
}
