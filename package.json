{
  "name": "login-page-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write '**/*.{js,ts,vue,html,scss}'",
    "format:svg": "prettier --write '**/*.svg' --parser=html",
    "format:lint": "prettier --write '**/*.{js,ts,vue,html,scss}' && eslint . --fix",
    "test:unit": "vitest --environment jsdom --coverage",
    "test:ui": "vitest --ui",
    "test-coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@primevue/themes": "^4.0.4",
    "pinia": "^2.2.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.0.4",
    "tailwindcss-primeui": "^0.3.4",
    "vee-validate": "^4.13.2",
    "vue": "^3.4.35",
    "vue-router": "^4.4.2",
    "vue3-toastify": "^0.2.2",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.41",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.8.2",
    "vite": "^5.4.1",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  }
}
